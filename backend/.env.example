# Copy to .env for local development. On Render, set these as environment
# variables in the service's dashboard instead of committing a .env file.

# Full JSON content of a Firebase service account key
# (Firebase Console > Project Settings > Service Accounts > Generate new private key).
# You can also paste it base64-encoded instead — more reliable in dashboard
# text fields that mangle multi-line pastes. Generate it with:
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\key.json"))
#   macOS/Linux: base64 -i key.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"hraifi-59736", ...}

# Comma-separated allowlist for the one-time POST /api/admin/claim bootstrap.
# Supports exact emails and *@domain wildcards.
ADMIN_BOOTSTRAP_EMAILS=kifachtv24@gmail.com,*@7raifi.ma

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=https://www.7raifi.ma,http://localhost:5500

PORT=3000
